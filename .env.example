# Environment configuration for Solar Microgrid Management System

# Serial Communication
ESP32_PORT=AUTO
ESP32_BAUD_RATE=115200
SERIAL_TIMEOUT_SEC=2.0

# Load Management Defaults (Watts)
CONFIGURED_LOAD_WATTS=5.0

# Anomaly and Safety Thresholds
MAX_SOLAR_VOLTAGE_V=21.0
MAX_SOLAR_CURRENT_MA=2500.0
MAX_TEMPERATURE_C=60.0
MIN_TEMPERATURE_C=0.0
LOW_BATTERY_VOLTAGE_V=3.2
HIGH_BATTERY_VOLTAGE_V=4.2

# Dataset Paths
DATA_DIR=data
MODELS_DIR=models
OUTPUTS_DIR=outputs

